{
  "name": "cap-snowflake-secondary-db",
  "version": "1.0.0",
  "description": "CAP service — HANA as primary DB, Snowflake as a named secondary DB for analytics",
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "deploy": "cds deploy --to hana"
  },
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "cap-snowflake": "^1.0.0",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "hana"
      },
      "snowflake": {
        "kind": "snowflake",
        "impl": "cap-snowflake"
      }
    },
    "[development]": {
      "requires": {
        "db": { "kind": "sqlite", "credentials": { "url": ":memory:" } }
      }
    }
  },
  "private": true
}
