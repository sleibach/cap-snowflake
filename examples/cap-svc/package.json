{
  "name": "cap-snowflake-bookshop",
  "version": "1.0.0",
  "description": "Bookshop CAP service — Snowflake as the primary database",
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "deploy": "cds deploy --to snowflake"
  },
  "dependencies": {
    "@sap/cds": "^9",
    "cap-snowflake": "^1.0.0",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "snowflake",
        "impl": "cap-snowflake"
      }
    },
    "[development]": {
      "requires": {
        "db": { "kind": "sqlite", "credentials": { "url": ":memory:" } }
      }
    }
  }
}
